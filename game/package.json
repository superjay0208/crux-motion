{
  "name": "crux-motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-worker.mjs && vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "tsc --noEmit && node scripts/build-worker.mjs && node scripts/build-info.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "campaign:check": "tsx scripts/validate-campaign.ts",
    "web:check": "playwright test",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "launch": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "planck": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.1",
    "esbuild": "0.24.2",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vitest": "2.1.8"
  }
}
